# Environment template for job-board-scraper.
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to source control.

# Compose-only local overrides (not read directly by AppSettings)
WEB_PORT=8000
POSTGRES_PORT=5432
POSTGRES_USER=jobs
# POSTGRES_PASSWORD is optional for local Compose; it defaults to "jobs".
POSTGRES_DB=jobs

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db
# For production: postgresql+asyncpg://user:password@host:5432/jobs  # pragma: allowlist secret

# =============================================================================
# Scheduler
# =============================================================================
# Cron expression for local APScheduler (UTC). Ignored when SCHEDULER_ENABLED=false.
SCHEDULE_CRON=0 2 * * *
TIMEZONE=UTC
# Enable APScheduler wrapper (disable in production — use external scheduler instead).
SCHEDULER_ENABLED=false
# Maximum duration (seconds) before a run is marked interrupted.
RUN_TIMEOUT_SECONDS=3600

# =============================================================================
# Alerting
# =============================================================================
# Email sink
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=scraper@example.com
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_SMTP_HOST=localhost
ALERT_EMAIL_SMTP_PORT=587
# ALERT_EMAIL_SMTP_USERNAME=  # set via environment
# SMTP_PASSWD=  # set via environment — DO NOT commit real value

# Slack sink
# Leave blank to disable Slack alerting.
ALERT_SLACK_WEBHOOK=

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
# Set to empty string to disable file logging.
LOG_FILE=./logs/scraper.log

# =============================================================================
# Rate Limiting
# =============================================================================
# Minimum delay (seconds) between consecutive requests to the same origin.
REQUEST_DELAY_MIN=2
# Maximum delay (seconds).
REQUEST_DELAY_MAX=5
# Maximum number of adapters that may run concurrently.
MAX_CONCURRENT_ADAPTERS=5

# =============================================================================
# Browser Automation
# =============================================================================
# Set to false in production (browser sources are blocked by ADR-0007 for release 1).
PLAYWRIGHT_BROWSERS_INSTALLED=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# =============================================================================
# Export
# =============================================================================
EXPORT_DIR=./data
# When true, CSV export contains only open jobs.
EXPORT_DEFAULT_OPEN_JOBS_ONLY=true
